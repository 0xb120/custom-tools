{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f /workspace/db/ptctl.py ]; then python3 /workspace/db/ptctl.py session start --client codex --quiet && python3 /workspace/db/ptctl.py context boot --max-chars 16000; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.codex/hooks/log-command.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.codex/hooks/render-after-db.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /workspace/.codex/hooks/engagement-doctor.sh"
          }
        ]
      }
    ]
  }
}
