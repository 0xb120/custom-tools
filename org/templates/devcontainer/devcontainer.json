{
  "name": "pentest-{{ACTIVITY_NAME}}",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BASE_IMAGE": "{{BASE_IMAGE}}",
      "INSTALL_GROUPS": "{{INSTALL_GROUPS}}",
      "CUSTOM_TOOLS_REF": "{{CUSTOM_TOOLS_REF}}",
      // Claude Code release channel (latest | stable | X.Y.Z) and the cache key
      // for the thin refresh layer at the end of the Dockerfile. CLAUDE_REFRESH
      // is the scaffold date: it invalidates that one small layer per new
      // engagement so the image always ships the current release, while the
      // expensive toolchain layer above it stays cached. Bump it by hand (or
      // pass --build-arg CLAUDE_REFRESH=$(date -u +%F)) to force a re-pull.
      "CLAUDE_CHANNEL": "{{CLAUDE_CHANNEL}}",
      "CLAUDE_REFRESH": "{{SCAFFOLD_DATE}}"
    },
    "options": ["--ssh=default"]
  },
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "remoteUser": "pentester",
  "containerUser": "pentester",
  "mounts": [
    // Agent CREDENTIALS ONLY. The host's ~/.claude and ~/.codex are deliberately
    // not mounted: plugins, marketplaces, skills and MCP servers are declared per
    // engagement (.claude/settings.json, .mcp.json, `codex mcp add` below), never
    // inherited from whatever the operator happens to have enabled on their
    // workstation. Inheriting them was actively harmful — an enabled host plugin
    // could install a SessionStart PATH shim that breaks the `python3 db/ptctl.py`
    // hooks, or drag in an MCP server pointing at a host-only binary.
    // These are --mount-style binds, so docker aborts container creation when the
    // source file is missing (it does not create a stray directory in its place);
    // up.sh checks both paths first to turn that into a readable message.
    "source=${localEnv:HOME}/.claude/.credentials.json,target=/seed/claude-credentials.json,type=bind,readonly",
    "source=${localEnv:HOME}/.codex/auth.json,target=/seed/codex-auth.json,type=bind,readonly",
    "source=${localEnv:HOME}/.ssh,target=/home/pentester/.ssh,type=bind,readonly",
    // DNS follows the host. Bind-mount the host resolver config read-only so the
    // container resolves names exactly like the host — VPN up/down included —
    // instead of freezing the stale snapshot Docker copies in at creation time.
    // Paired with --network=host below this makes the container a filesystem
    // sandbox on the host's own network stack, with no separate internet rules.
    // Caveat: resolvconf replaces /etc/resolv.conf atomically (rename), so a
    // mid-session host network/VPN change is picked up on the next container
    // start — re-run up.sh or `docker restart {{ACTIVITY_NAME}}` to refresh.
    "source=/etc/resolv.conf,target=/etc/resolv.conf,type=bind,readonly"
  ],
  "runArgs": [
    "--name", "{{ACTIVITY_NAME}}",
    "--cap-add=NET_RAW",
    "--cap-add=NET_ADMIN",
    "--network=host",
    "--env-file", "${localWorkspaceFolder}/.devcontainer/.env"
  ],
  // Copy the two mounted credential files into the agents' config dirs (they are
  // written to at token refresh, so they cannot be used from the read-only mount),
  // register the engagement's Burp MCP server for Codex (which ignores
  // project-scoped mcp_servers), and install the plugins this engagement declares
  // in .claude/settings.json. Nothing is imported from the host: Claude
  // regenerates a clean ~/.claude.json and gets exactly the declared plugin set.
  // Every step is non-fatal — a failure costs a manual command, not the container.
  "postCreateCommand": "install -d -m 700 /home/pentester/.claude /home/pentester/.codex; install -m 600 /seed/claude-credentials.json /home/pentester/.claude/.credentials.json || echo '[!] Claude credential copy failed — run claude and log in manually'; install -m 600 /seed/codex-auth.json /home/pentester/.codex/auth.json || echo '[!] Codex credential copy failed — run codex login'; codex mcp get burp >/dev/null 2>&1 || codex mcp add burp -- npx -y mcp-remote {{BURP_MCP_URL}} || echo '[!] codex mcp add burp failed — add manually: codex mcp add burp -- npx -y mcp-remote {{BURP_MCP_URL}}'; bash /home/pentester/custom-tools/org/sync-agent-plugins.sh /workspace || echo '[!] plugin sync incomplete — fix .claude/settings.json, then: bash ~/custom-tools/org/sync-agent-plugins.sh /workspace'; echo 'Engagement container ready. Run: claude  (or: codex)'"
}
